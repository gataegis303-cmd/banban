# ──────────────────────────────────────
# BanBan 后端环境变量模板
# 复制为 .env 并填入真实值
# ──────────────────────────────────────

# 应用
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-64-char-random-string

# 数据库
POSTGRES_USER=banban
POSTGRES_PASSWORD=banban_dev_2025
POSTGRES_DB=banban
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://banban:banban_dev_2025@postgres:5432/banban

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# 短信验证码（可选，以下为默认值）
# SMS_CODE_TTL_SECONDS=300
# SMS_SEND_COOLDOWN_SECONDS=60
# SMS_DAILY_LIMIT=10
# SMS_IP_DAILY_LIMIT=20
# SMS_CODE_MAX_ATTEMPTS=5

# 阿里云短信（未配置 AK 时开发环境自动使用 DevMock：验证码打进日志）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=斑斑
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou

# 阿里云实人认证（未配置 AK 时开发环境自动降级：身份证走本地校验码算法、活体直通）
ALIYUN_REALPERSON_ACCESS_KEY_ID=
ALIYUN_REALPERSON_ACCESS_KEY_SECRET=

# 微信 OAuth
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Apple Sign-In（APPLE_BUNDLE_ID 须与 iOS 工程 PRODUCT_BUNDLE_IDENTIFIER 一致）
APPLE_BUNDLE_ID=com.mia369.banban
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# identity_token 公钥来源；默认 Apple 官方，联调可指向本地 mock JWKS
# APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# OSS（照片存储）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=banban-prod
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_CDN_DOMAIN=

# Nginx
NGINX_PORT=80
