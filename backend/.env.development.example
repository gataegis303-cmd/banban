# ──────────────────────────────────────
# BanBan 后端环境变量（本地开发版）
# 用法：复制为 backend/.env（.gitignore 已忽略，不会入库）
#
# 与 .env.example（docker compose 场景）的差异：
#   1. DATABASE_URL / REDIS_HOST 用 localhost（宿主机映射端口）
#   2. APPLE_JWKS_URL 指向本地 mock JWKS（8081 端口，联调用）
# ──────────────────────────────────────

# 应用
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-64-char-random-string
# uvicorn 额外参数：本地手动启动不读此项（compose 专用），留空即可
UVICORN_ARGS=

# 数据库（本地跑 uvicorn / alembic 用 localhost；compose 内才是 postgres）
POSTGRES_USER=banban
POSTGRES_PASSWORD=banban_dev_2025
POSTGRES_DB=banban
DATABASE_URL=postgresql+asyncpg://banban:banban_dev_2025@localhost:5432/banban

# Redis（本地 uvicorn 连宿主机映射端口）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# 短信验证码（可选，不配即用默认值）
# SMS_CODE_TTL_SECONDS=300
# SMS_SEND_COOLDOWN_SECONDS=60
# SMS_DAILY_LIMIT=10
# SMS_IP_DAILY_LIMIT=20
# SMS_CODE_MAX_ATTEMPTS=5

# 通用 IP 限流（固定窗口，次/分钟）
# RATE_LIMIT_VERIFY_PER_MINUTE=10
# RATE_LIMIT_REFRESH_PER_MINUTE=30
# RATE_LIMIT_OAUTH_PER_MINUTE=10

# 阿里云短信（不配 AK → DevMock：验证码打进日志，debug_code 直接可用）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=斑斑
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou

# 阿里云实人认证（不配 → 降级：身份证本地校验算法、活体直通）
ALIYUN_REALPERSON_ACCESS_KEY_ID=
ALIYUN_REALPERSON_ACCESS_KEY_SECRET=

# 微信 OAuth
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Apple Sign-In（联调本地 mock JWKS；上线前注释掉走 Apple 官方）
APPLE_BUNDLE_ID=com.mia369.banban
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_JWKS_URL=http://127.0.0.1:8081/jwks.json

# APNs 离线推送（不配 → DevMock：推送内容打进日志）
# .p8 私钥放 backend/secrets/（.gitignore 已忽略 *.p8）
# 配置步骤见 docs/apns-real-device-setup.md
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
APNS_USE_SANDBOX=true

# OSS（照片存储；未配 → 本地 dev mock 存储 backend/data/）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=banban-prod
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_CDN_DOMAIN=

# Nginx（仅 compose 用）
NGINX_PORT=80
